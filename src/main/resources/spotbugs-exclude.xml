<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Temporary suppressions for lazy init / accessible field warnings. -->
  <Match>
    <Class name="net.openhft.posix.internal.PosixAPIHolder"/>
    <Bug pattern="LI_LAZY_INIT_STATIC,MS_CANNOT_BE_FINAL,PA_PUBLIC_PRIMITIVE_ATTRIBUTE"/>
  </Match>
  <Match>
    <Class name="net.openhft.posix.internal.UnsafeMemory"/>
    <Bug pattern="DP_DO_INSIDE_DO_PRIVILEGED"/>
  </Match>
  <Match>
    <Class name="net.openhft.posix.internal.jnr.JNRPosixAPI$FileLocker"/>
    <Bug pattern="CT_CONSTRUCTOR_THROW,EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>

